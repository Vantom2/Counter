<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.Views.MainPage"
             Title="Counter">

  
    <Grid RowDefinitions="Auto,*" Padding="10" RowSpacing="10">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Entry x:Name="NameEntry"
                   Placeholder="Nazwa nowego licznika..."
                   Grid.Column="0" />
            <Button Text="Dodaj"
                    Grid.Column="1"
                    Clicked="AddCounterClicked" />

            <Button Text="Zapisz"
                    Grid.Column="2"
                    BackgroundColor="Green"
                    TextColor="White"
                    Clicked="SaveClicked" />
        </Grid>

        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Counters}">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Border Stroke="Gray"
                            StrokeThickness="1"
                            Padding="15"
                            Margin="0,5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>

                       
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                              ColumnSpacing="10">

                           
                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   Grid.Column="0" />

                            <Button Text="-"
                                    Grid.Column="1"
                                    WidthRequest="50"
                                    Clicked="MinusClicked" />

                            
                            <Label Text="{Binding Value}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   WidthRequest="50"
                                   HorizontalTextAlignment="Center"
                                   VerticalOptions="Center"
                                   Grid.Column="2" />

                            <Button Text="+"
                                    Grid.Column="3"
                                    WidthRequest="50"
                                    Clicked="PlusClicked" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
